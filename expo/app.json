{
  "expo": {
    "name": "TRIAD Prayer",
    "owner": "tuwawahs-organization",
    "slug": "triad-prayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amen-app",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.iammadewhole.triad",
      "appleTeamId": "6SQD435D7H",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false,
          "NSExceptionDomains": {}
        },
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "12"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.iammadewhole.amen",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://tearsandoil.com/",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; frame-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.revenuecat.com https://*.revenuecat.com https://texttospeech.googleapis.com https://iammadewhole.com https://tearsandoil.com https://*.iammadewhole.com https://*.tearsandoil.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; block-all-mixed-content",
            "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "DENY",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "accelerometer=(), autoplay=(), camera=(), display-capture=(), fullscreen=(self), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()",
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Resource-Policy": "same-origin",
            "Origin-Agent-Cluster": "?1",
            "X-DNS-Prefetch-Control": "off",
            "X-Permitted-Cross-Domain-Policies": "none"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-notifications",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/triad-prayer-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0804"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.iammadewhole.triad",
          "widgets": [
            {
              "name": "TodayTruth",
              "displayName": "Today's Truth",
              "description": "Your daily truth from TRIAD Prayer",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "605c5716-dd17-4109-bcc6-1a4bc58c6319"
      }
    }
  }
}
